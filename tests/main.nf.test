nextflow_pipeline {

    name "nf-codonyat – full pipeline"
    script "../main.nf"
    tag "pipeline"

    test("test data: two SAM samples and one FASTQ pair give per-sample TSV/XML, a merged summary and MultiQC") {

        when {
            params {
                samplesheet = "${projectDir}/assets/testdata/samplesheet.csv"
                reference   = "${projectDir}/assets/testdata/reference.fasta"
                amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
                outdir      = "${outputDir}"
            }
        }

        then {
            def summary = path("${outputDir}/codonyat_summary.tsv").readLines()*.split('\t')
            def header  = summary[0] as List
            def rows    = summary.drop(1).collect { r -> [header, r as List].transpose().collectEntries() }
            def freq    = { String s, String pos, String codon ->
                rows.find { r -> r.SAMPLE == s && r.POSITION == pos && r.VARIANT == codon }?.FREQ
            }

            assertAll(
                { assert workflow.success },
                // FASTQ: fastqc, fastp, bowtie2 build + align; all 3: flagstat x2, view, codonyat; summary, multiqc
                { assert workflow.trace.succeeded().size() == 18 },

                // per-sample outputs
                { assert path("${outputDir}/samples/sample1/sample1.tsv").exists() },
                { assert path("${outputDir}/samples/sample1/sample1.xml").text.contains('<SamContainer') },
                { assert path("${outputDir}/samples/sample2/sample2.tsv").exists() },
                { assert path("${outputDir}/samples/sample2/sample2.xml").text.contains('<Position') },

                { assert path("${outputDir}/samples/HVG286PL/HVG286PL.tsv").exists() },

                // FASTQ path: QC, trimming, alignment and flagstat outputs
                { assert path("${outputDir}/fastqc/HVG286PL_1_fastqc.html").exists() },
                { assert path("${outputDir}/fastqc/HVG286PL_2_fastqc.zip").exists() },
                { assert path("${outputDir}/fastp/HVG286PL.fastp.json").text.contains('"filtering_result"') },
                { assert path("${outputDir}/alignment/HVG286PL.bam").exists() },
                { assert path("${outputDir}/alignment/HVG286PL.bowtie2.log").text.contains('overall alignment rate') },
                { assert path("${outputDir}/alignment/flagstat/HVG286PL.aligned.flagstat").exists() },
                { assert path("${outputDir}/alignment/flagstat/HVG286PL.filtered.flagstat").exists() },
                { assert path("${outputDir}/alignment/flagstat/sample1.filtered.flagstat").exists() },
                { assert path("${outputDir}/multiqc/multiqc_report.html").exists() },
                { assert path("${outputDir}/multiqc/multiqc_report_data/multiqc_fastp.txt").exists() },
                { assert path("${outputDir}/multiqc/multiqc_report_data/multiqc_bowtie2.txt").exists() },
                { assert path("${outputDir}/multiqc/multiqc_report_data/multiqc_samtools_flagstat.txt").exists() },

                // execution reports follow the outdir (nf-test redirects the trace to its own meta/ folder)
                { assert path("${outputDir}/pipeline_info/execution_report.html").exists() },
                { assert path("${outputDir}/pipeline_info/execution_timeline.html").exists() },
                { assert path("${outputDir}/pipeline_info/pipeline_dag.html").exists() },

                // merged summary: real rows from all three samples
                { assert header == ['SAMPLE', 'FILE', 'REFERENCE', 'PROTEIN', 'VARIANT', 'POSITION',
                                    'FREQ', 'FWCOV', 'RVCOV', 'TOTALCOV', 'RATIO'] },
                { assert rows.size() > 200 },
                { assert rows*.SAMPLE.unique().sort() == ['HVG286PL', 'sample1', 'sample2'] },
                { assert rows.count { r -> r.SAMPLE == 'HVG286PL' } > 1000 },
                { assert rows.every { r -> r.PROTEIN == 'RT' && r.VARIANT && r.FREQ } },

                // spiked-in mutations (see assets/testdata/make_testdata.py)
                { assert freq('sample1', '2670', 'CTG') == '24.528' },   // M41L
                { assert freq('sample1', '2742', 'AGA') == '9.434'  },   // K65R
                { assert freq('sample1', '3099', 'GTG') == '50.0'   },   // M184V
                { assert freq('sample2', '2754', '---') == '8.163'  },   // T69 deletion
                { assert freq('sample2', '3099', 'GTG') == null     },   // sample2 is wild type at 184

                // real data (HVG286PL, 2000 read pairs): the sample consensus codon at 2550 dominates
                { assert (freq('HVG286PL', '2550', 'CCC') as double) > 90 },

                { assert snapshot(
                    path("${outputDir}/codonyat_summary.tsv"),
                    path("${outputDir}/samples/sample1/sample1.tsv"),
                    path("${outputDir}/samples/sample2/sample2.tsv"),
                    path("${outputDir}/samples/HVG286PL/HVG286PL.tsv"),
                    path("${outputDir}/samples/sample1/sample1.xml"),
                    path("${outputDir}/samples/sample2/sample2.xml")
                ).match() }
            )
        }
    }

    test("an old-style sample,sam samplesheet still works") {

        when {
            params {
                samplesheet = "${projectDir}/tests/samplesheet_sam_only.csv"
                reference   = "${projectDir}/assets/testdata/reference.fasta"
                amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
                outdir      = "${outputDir}"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("${outputDir}/samples/sample1/sample1.tsv").md5 == '7b53cdae533aaa882f14066b50e34cad' },
                { assert path("${outputDir}/codonyat_summary.tsv").readLines().size() > 100 }
            )
        }
    }

    test("fails when a samplesheet row has both FASTQ and SAM") {

        when {
            params {
                samplesheet = "${projectDir}/tests/samplesheet_fastq_and_sam.csv"
                reference   = "${projectDir}/assets/testdata/reference.fasta"
                amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
                outdir      = "${outputDir}"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains("sample 'bad' must have either fastq_1 or sam") }
        }
    }

    test("fails with a clear message when --samplesheet is missing") {

        when {
            params {
                reference = "${projectDir}/assets/testdata/reference.fasta"
                amplicons = "${projectDir}/assets/testdata/amplicons.tsv"
                outdir    = "${outputDir}"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter(s): --samplesheet') }
        }
    }

    test("fails when --protein is not annotated in the reference") {

        when {
            params {
                samplesheet = "${projectDir}/assets/testdata/samplesheet.csv"
                reference   = "${projectDir}/assets/testdata/reference.fasta"
                amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
                protein     = "NEF"
                outdir      = "${outputDir}"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('no annotation for --protein NEF') }
        }
    }

    test("warns but succeeds when --outdir is changed by a -c config file") {

        config "./outdir_from_c.config"

        when {
            params {
                samplesheet = "${projectDir}/assets/testdata/samplesheet.csv"
                reference   = "${projectDir}/assets/testdata/reference.fasta"
                amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
            }
        }

        then {
            def outdir = "${launchDir}/outdir-from-c"
            // log.warn goes to the Nextflow log (nf-test's stdout capture only holds errors here)
            def log = path("${launchDir}/meta/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert log.contains('WARN') && log.contains('params.outdir was set in a config file passed with -c') },
                { assert log.contains("${launchDir}/results/pipeline_info") },
                { assert log.contains('Use --outdir or -params-file') },
                // results follow the -c outdir ...
                { assert path("${outdir}/codonyat_summary.tsv").readLines().size() > 200 },
                { assert path("${outdir}/samples/sample1/sample1.tsv").exists() },
                // ... while the reports stay in the default pipeline_info folder
                { assert !path("${outdir}/pipeline_info").exists() },
                { assert path("${launchDir}/results/pipeline_info/execution_report.html").exists() }
            )
        }
    }
}
