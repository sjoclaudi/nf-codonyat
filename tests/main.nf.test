nextflow_pipeline {

    name "nf-codonyat – full pipeline"
    script "../main.nf"
    tag "pipeline"

    test("test data: two samples give per-sample TSV/XML and a merged summary") {

        when {
            params {
                samplesheet = "${projectDir}/assets/testdata/samplesheet.csv"
                reference   = "${projectDir}/assets/testdata/reference.fasta"
                amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
                outdir      = "${outputDir}"
            }
        }

        then {
            def summary = path("${outputDir}/codonyat_summary.tsv").readLines()*.split('\t')
            def header  = summary[0] as List
            def rows    = summary.drop(1).collect { r -> [header, r as List].transpose().collectEntries() }
            def freq    = { String s, String pos, String codon ->
                rows.find { r -> r.SAMPLE == s && r.POSITION == pos && r.VARIANT == codon }?.FREQ
            }

            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().size() == 3 },

                // per-sample outputs
                { assert path("${outputDir}/samples/sample1/sample1.tsv").exists() },
                { assert path("${outputDir}/samples/sample1/sample1.xml").text.contains('<SamContainer') },
                { assert path("${outputDir}/samples/sample2/sample2.tsv").exists() },
                { assert path("${outputDir}/samples/sample2/sample2.xml").text.contains('<Position') },

                // merged summary: real rows from both samples
                { assert header == ['SAMPLE', 'FILE', 'REFERENCE', 'PROTEIN', 'VARIANT', 'POSITION',
                                    'FREQ', 'FWCOV', 'RVCOV', 'TOTALCOV', 'RATIO'] },
                { assert rows.size() > 200 },
                { assert rows*.SAMPLE.unique().sort() == ['sample1', 'sample2'] },
                { assert rows.every { r -> r.PROTEIN == 'RT' && r.VARIANT && r.FREQ } },

                // spiked-in mutations (see assets/testdata/make_testdata.py)
                { assert freq('sample1', '2670', 'CTG') == '24.528' },   // M41L
                { assert freq('sample1', '2742', 'AGA') == '9.434'  },   // K65R
                { assert freq('sample1', '3099', 'GTG') == '50.0'   },   // M184V
                { assert freq('sample2', '2754', '---') == '8.163'  },   // T69 deletion
                { assert freq('sample2', '3099', 'GTG') == null     },   // sample2 is wild type at 184

                { assert snapshot(
                    path("${outputDir}/codonyat_summary.tsv"),
                    path("${outputDir}/samples/sample1/sample1.tsv"),
                    path("${outputDir}/samples/sample2/sample2.tsv"),
                    path("${outputDir}/samples/sample1/sample1.xml"),
                    path("${outputDir}/samples/sample2/sample2.xml")
                ).match() }
            )
        }
    }

    test("fails with a clear message when --samplesheet is missing") {

        when {
            params {
                reference = "${projectDir}/assets/testdata/reference.fasta"
                amplicons = "${projectDir}/assets/testdata/amplicons.tsv"
                outdir    = "${outputDir}"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter(s): --samplesheet') }
        }
    }

    test("fails when --protein is not annotated in the reference") {

        when {
            params {
                samplesheet = "${projectDir}/assets/testdata/samplesheet.csv"
                reference   = "${projectDir}/assets/testdata/reference.fasta"
                amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
                protein     = "NEF"
                outdir      = "${outputDir}"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('no annotation for --protein NEF') }
        }
    }
}
