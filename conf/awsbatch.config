/*
 * AWS Batch executor (Spot). The head node does not run Docker; Batch/ECS
 * pulls process containers on the compute AMI. No Wave, no Fusion, no Seqera
 * token. Public images: ghcr.io/sjoclaudi/nf-codonyat and
 * community.wave.seqera.io (anonymous pull).
 *
 * Queue is Spot-only (default params.awsbatch_queue). Do not add an on-demand
 * queue or fallback here.
 *
 * Resource requests match xlarge / 2xlarge (m6i/m7i/r6i/r7i): process_high is
 * 4 CPU / 16 GB, KRAKEN2_KRAKEN2 is 10 GB (Standard-8). On Spot reclaim or OOM
 * the task is retried with more memory, capped by process.resourceLimits.
 */

process {
    executor       = 'awsbatch'
    queue          = params.awsbatch_queue
    resourceLimits = [cpus: 16, memory: 120.GB, time: 24.h]

    // Spot reclaim / OOM / abort / segfault. Other exit codes fail the run.
    errorStrategy = { task.exitStatus in [137, 143, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 3

    withLabel: 'error_retry' {
        errorStrategy = { task.exitStatus in [137, 143, 104, 134, 139] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    withLabel: 'process_single' {
        memory = { 2.GB * task.attempt }
    }
    withLabel: 'process_low' {
        memory = { 2.GB * task.attempt }
    }
    withLabel: 'process_medium' {
        memory = { 8.GB * task.attempt }
    }
    withLabel: 'process_high' {
        memory = { 16.GB * task.attempt }
    }

    // withName memory in modules.config is static; re-introduce attempt scaling
    withName: 'KRAKEN2_KRAKEN2' {
        memory = { 10.GB * task.attempt }
    }
    withName: 'BOWTIE2_BUILD' {
        memory = { 4.GB * task.attempt }
    }
    withName: 'BBMAP_BBSPLIT' {
        memory = { 4.GB * task.attempt }
    }
    withName: 'BBMAP_BBMERGE' {
        memory = { 4.GB * task.attempt }
    }
}

aws {
    region = 'eu-central-1'
    batch {
        cliPath         = '/home/ec2-user/miniconda/bin/aws'
        maxSpotAttempts = 3
    }
}

docker.enabled = false
