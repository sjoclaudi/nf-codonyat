/*
 * Tiny influenza A custom-mode test: synthetic A/Puerto Rico/8/1934 HA+NA
 * pairs with a two-record FASTA, 4-column BED annotation and one primer
 * pair per segment.
 *   nextflow run . -profile test_flua,<docker/conda>
 * Contamination is skipped (no influenza Kraken2 DB is bundled).
 * Research use only.
 */
params {
    config_profile_name        = 'Influenza A custom-mode test profile'
    config_profile_description = 'Synthetic A/PR/8/34 HA+NA pairs with BED annotation and per-segment primers'

    preset             = 'custom'
    input              = "${projectDir}/assets/testdata/influenza/samplesheet.csv"
    reference          = "${projectDir}/assets/testdata/influenza/reference.fasta"
    primer_bed         = "${projectDir}/assets/testdata/influenza/primers.bed"
    annotation         = "${projectDir}/assets/testdata/influenza/annotation.bed"
    skip_contamination = true
    outdir             = 'results-test-flua'
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 15.GB,
        time: 6.h
    ]
}
