/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-codonyat -profile test,<docker/singularity/conda>
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    // Input data
    samplesheet = "${projectDir}/assets/testdata/samplesheet.csv"
    reference   = "${projectDir}/assets/testdata/reference.fasta"
    amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
    kraken2_db  = "${projectDir}/assets/testdata/kraken2_tiny_db"
    outdir      = 'results-test'
}
