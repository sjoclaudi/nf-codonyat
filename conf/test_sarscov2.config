/*
 * Tiny SARS-CoV-2 custom-mode test: synthetic MN908947.3 amplicon pairs
 * with an unannotated FASTA, ARTIC v4.1 primer BED and GFF3 CDS.
 *   nextflow run . -profile test_sarscov2,<docker/conda>
 * Contamination is skipped (no SARS-CoV-2 Kraken2 DB is bundled).
 * Research use only.
 */
params {
    config_profile_name        = 'SARS-CoV-2 custom-mode test profile'
    config_profile_description = 'Synthetic MN908947.3 amplicon pairs with ARTIC v4.1 primers and GFF3 annotation'

    preset             = 'custom'
    input              = "${projectDir}/assets/testdata/sarscov2/samplesheet_sim.csv"
    reference          = "${projectDir}/assets/testdata/sarscov2/reference.fasta"
    primer_bed         = "${projectDir}/assets/testdata/sarscov2/primers.bed"
    annotation         = "${projectDir}/assets/testdata/sarscov2/annotation.gff3"
    skip_contamination = true
    outdir             = 'results-test-sarscov2'
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 15.GB,
        time: 6.h
    ]
}
