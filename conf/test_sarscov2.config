/*
 * Tiny SARS-CoV-2 test: synthetic S-gene pairs + ARTIC v4.1 preset.
 *   nextflow run . -profile test_sarscov2,<docker/conda>
 * Contamination is skipped (no SARS-CoV-2 Kraken2 DB is bundled).
 * Research use only.
 */
params {
    config_profile_name        = 'SARS-CoV-2 test profile'
    config_profile_description = 'Synthetic MN908947.3 S-gene pairs with the ARTIC v4.1 primer BED'

    preset             = 'sars-cov-2'
    input              = "${projectDir}/assets/testdata/sarscov2/samplesheet.csv"
    skip_contamination = true
    skip_subtype       = true
    outdir             = 'results-test-sarscov2'
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 15.GB,
        time: 6.h
    ]
}
