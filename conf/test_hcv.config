/*
 * Tiny HCV preset test: synthetic H77 POLY pairs with no primer BED
 * (requires_primer_bed false; primer trimming skipped).
 *   nextflow run . -profile test_hcv,<docker/conda>
 * Contamination is skipped (no HCV Kraken2 DB is bundled).
 * Research use only.
 */
params {
    config_profile_name        = 'HCV preset test profile'
    config_profile_description = 'Synthetic NC_004102.1 POLY pairs with no primer BED'

    preset             = 'hcv'
    input              = "${projectDir}/assets/testdata/hcv/samplesheet.csv"
    skip_contamination = true
    outdir             = 'results-test-hcv'
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 15.GB,
        time: 6.h
    ]
}
