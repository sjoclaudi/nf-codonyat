/*
 * Tiny HBV preset test: synthetic X02763 pairs using the bundled
 * hbv/600/v2.1.0 primers (one amplicon).
 *   nextflow run . -profile test_hbv,<docker/conda>
 * Contamination is skipped (no HBV Kraken2 DB is bundled).
 * Research use only.
 */
params {
    config_profile_name        = 'HBV preset test profile'
    config_profile_description = 'Synthetic X02763 pairs with bundled hbv/600/v2.1.0 primers'

    preset             = 'hbv'
    input              = "${projectDir}/assets/testdata/hbv/samplesheet.csv"
    skip_contamination = true
    outdir             = 'results-test-hbv'
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 15.GB,
        time: 6.h
    ]
}
