/*
 * =========================================================
 *  nf-codonyat  nextflow.config
 * =========================================================
 *  Codon-aware amino acid variant typing Nextflow pipeline
 * =========================================================
 */

manifest {
    name            = 'mnoguera/nf-codonyat'
    author          = 'Marc Noguera Julian'
    homePage        = 'https://github.com/mnoguera/nf-codonyat'
    description     = 'Codon-aware amino acid variant typing from SAM alignments of viral amplicon NGS data'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    version         = '0.1.0'
    doi             = ''
}

// Global default parameters
params {
    // Input files
    samplesheet     = null            // CSV: sample,sam
    reference       = null            // Annotated reference FASTA
    amplicons       = null            // TSV: label,protein,reference,5p_seq,3p_seq,start,end

    // Analysis options
    protein         = 'RT'            // Protein name to analyse
    ratio_upper     = 3.16227766      // Strand ratio upper threshold (10× fold)
    ratio_lower     = 0.316227766     // Strand ratio lower threshold (0.1× fold)
    entropy_threshold = 0.0           // Minimum Shannon entropy per position

    // Output
    outdir          = 'results'
    publish_dir_mode = 'copy'

    // Engine config
    hook_url        = ''              // Optional notification URL
}

// Load module-level config (process labels, conda/pip envs)
includeConfig 'modules.config'

// ============================================================
// Profiles  (activated with  -profile <name> )
// ============================================================

profiles {
    standard {
        executor.name = 'local'
        process.executor = 'local'
    }

    singularity {
        singularity.enabled  = true
        singularity.autoMounts = true
    }

    docker {
        docker.enabled       = true
        docker.userEmulation  = true
    }

    conda {
        conda.enabled        = true
    }

    test {
        params {
            samplesheet = "${projectDir}/assets/testdata/samplesheet.csv"
            reference   = "${projectDir}/assets/testdata/reference.fasta"
            amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
            outdir      = '/tmp/nf-codonyat-test'
        }
    }
}

// ============================================================
// Notification
// ============================================================

if (params.hook_url) {
    workflow.onComplete {
        def msg = """\
            Pipeline complete
            ─────────────────────────────────────────
            Status : ${workflow.success ? 'SUCCESS' : 'FAILURE'}
            Work dir: ${workflow.workDir}
            Results : ${params.outdir}
        """
        ['curl', '-X', 'POST', '--data-urlencode', "payload={\"text\": ${msg.toString().encode()} }", params.hook_url].execute()
    }
}
