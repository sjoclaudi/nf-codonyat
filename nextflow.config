/*
 * =========================================================
 *  nf-codonyat  nextflow.config
 * =========================================================
 *  Codon-aware amino acid variant typing Nextflow pipeline
 * =========================================================
 */

// Nextflow plugins
plugins {
    id 'nf-schema@2.8.0'
    id 'nf-prov@1.7.0'
}

manifest {
    name            = 'sjoclaudi/nf-codonyat'
    author          = 'Marc Noguera Julian'
    contributors    = [[name: 'Marc Noguera Julian', contribution: ['author', 'maintainer']]]
    homePage        = 'https://github.com/sjoclaudi/nf-codonyat'
    description     = 'Codon-aware amino acid variant typing of HIV-1 amplicon NGS data (FASTQ or SAM); research use only'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '0.4.0'
    doi             = ''
}

// Global default parameters
params {
    // Input files
    input             = null          // CSV: sample,fastq_1,fastq_2,sam (paths may be relative to the CSV)
    samplesheet       = null          // Alias for --input (deprecated, use --input)
    reference         = null          // Annotated reference FASTA
    amplicons         = null          // TSV: label,protein,reference,5p_seq,3p_seq,start,end

    // Analysis options
    protein           = 'all'         // Protein(s): one name, a comma-separated list (e.g. PR,RT,INT) or 'all' annotated
    ratio_upper       = 3.16227766    // Strand ratio upper threshold (10^0.5)
    ratio_lower       = 0.316227766   // Strand ratio lower threshold (10^-0.5)
    entropy_threshold = 0.0           // Minimum Shannon entropy per position

    // Read processing (FASTQ samples)
    fastp_args        = '--qualified_quality_phred 20 --unqualified_percent_limit 40 --length_required 50 --cut_tail --cut_tail_mean_quality 20'
    bowtie2_args      = '--very-sensitive-local'

    // Step 2: contamination report (Kraken2; report only, no reads removed)
    kraken2_db                   = null    // Kraken2 database folder (e.g. Standard-8); required for FASTQ unless --skip_contamination
    skip_contamination           = false
    kraken2_confidence           = 0.0
    kraken2_memory_mapping       = false
    contamination_warn_hiv_pct   = 50      // warn when HIV-1 < this % of classified fragments
    contamination_warn_human_pct = 50      // warn when human > this % of all fragments

    // Step 3: subtype estimate (BBSplit vs reference panel; read-mapping based)
    subtype_panel                = "${projectDir}/assets/presets/hiv1_subtype_panel_v1"
    skip_subtype                 = false
    subtype_min_reads            = 100     // fewer assigned reads → 'undetermined'
    subtype_min_margin           = 10      // % points between the top two bins

    // Step 5: read-pair merging (BBMerge, PE only)
    merge_pairs                  = true
    bbmerge_args                 = ''      // extra BBMerge arguments (BBMerge defaults otherwise)
    strand_metrics_unmerged      = true    // D9: strand metrics from all pre-merge pairs (PE + merge_pairs only)

    // Step 6: consensus (iVar)
    skip_consensus               = false
    consensus_threshold          = 0.5     // iVar -t (IUPAC code for mixtures above this)
    consensus_min_depth          = 100     // iVar -m (N below this depth)
    consensus_insertion_threshold = 0.5    // iVar -c (majority-rule insertions; majority deletions are applied)
    consensus_min_bq             = 20      // iVar -q

    // Alignment filter (FASTQ and SAM samples)
    min_mapq          = 20            // samtools view -q
    exclude_flags     = '0x904'       // samtools view -F: unmapped, secondary, supplementary

    // Output
    outdir            = 'results'
    publish_dir_mode  = 'copy'
    save_intermediates = false        // also publish trimmed FASTQ, per-part BAMs and Kraken2 per-read output

    // nf-schema / help
    help              = false
    helpFull          = false
    showHidden        = false
    validate_params   = true

    // nf-prov (official Nextflow plugin; off by default)
    prov_enabled      = false
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load modules.config for process specific options
includeConfig 'modules.config'

// ============================================================
// nf-schema validation / help
// ============================================================
validation {
    help {
        enabled = true
    }
    logging {
        unrecognisedParams = 'error'
    }
    // profile metadata from conf/test*.config is not in the schema
    ignoreParams = ['config_profile_name', 'config_profile_description', 'genomes']
}

// ============================================================
// nf-prov provenance reports (BCO / WRROC / DAG)
// Disabled unless --prov_enabled true. Outputs land in pipeline_info/.
// ============================================================
prov {
    enabled = params.prov_enabled
    formats {
        bco {
            file      = "${params.outdir}/pipeline_info/bco.json"
            overwrite = true
        }
        // WRROC crate root = parent of this file → keep at outdir root so published results are included
        wrroc {
            file      = "${params.outdir}/ro-crate-metadata.json"
            overwrite = true
        }
        dag {
            file      = "${params.outdir}/pipeline_info/prov_dag.html"
            overwrite = true
        }
    }
}

// ============================================================
// Profiles  (activated with  -profile <name> )
// ============================================================

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
    }

    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
    }

    podman {
        podman.enabled      = true
        podman.userEmulation = true
        conda.enabled       = false
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        includeConfig 'conf/test.config'
    }

    test_full {
        includeConfig 'conf/test_full.config'
    }
}

// ============================================================
// Execution reports → <outdir>/pipeline_info/
// ============================================================
// Nextflow 26.04 resolves these paths when this file is read; it has no lazy
// paths for reports (closures and lazy strings are not supported in the
// strict config syntax). This block sits after the profiles, so --outdir on
// the command line, -params-file and profiles are all honoured. Config files
// passed with -c are read AFTER this file, so a params.outdir set there
// cannot reach these paths: main.nf compares the two and, if they differ,
// warns where the reports went and recommends --outdir / -params-file.
params.pipeline_info_outdir = params.outdir   // internal: do not set

timeline {
    enabled   = true
    file      = "${params.pipeline_info_outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.pipeline_info_outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.pipeline_info_outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.pipeline_info_outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
