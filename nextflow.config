/*
 * =========================================================
 *  nf-codonyat  nextflow.config
 * =========================================================
 *  Codon-aware amino acid variant typing Nextflow pipeline
 * =========================================================
 */

manifest {
    name            = 'sjoclaudi/nf-codonyat'
    contributors    = [[name: 'Marc Noguera Julian', contribution: ['author', 'maintainer']]]
    homePage        = 'https://github.com/sjoclaudi/nf-codonyat'
    description     = 'Codon-aware amino acid variant typing from SAM alignments of viral amplicon NGS data'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '0.1.0'
}

// Global default parameters
params {
    // Input files
    samplesheet       = null          // CSV: sample,sam (SAM paths may be relative to the CSV)
    reference         = null          // Annotated reference FASTA
    amplicons         = null          // TSV: label,protein,reference,5p_seq,3p_seq,start,end

    // Analysis options
    protein           = 'RT'          // Protein name to analyse
    ratio_upper       = 3.16227766    // Strand ratio upper threshold (10^0.5)
    ratio_lower       = 0.316227766   // Strand ratio lower threshold (10^-0.5)
    entropy_threshold = 0.0           // Minimum Shannon entropy per position

    // Output
    outdir            = 'results'
    publish_dir_mode  = 'copy'
}

// Process resources and publishing rules
includeConfig 'modules.config'

// ============================================================
// Profiles  (activated with  -profile <name> )
// ============================================================

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
    }

    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.samplesheet = "${projectDir}/assets/testdata/samplesheet.csv"
        params.reference   = "${projectDir}/assets/testdata/reference.fasta"
        params.amplicons   = "${projectDir}/assets/testdata/amplicons.tsv"
        params.outdir      = 'results-test'
        process.resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
    }
}

// ============================================================
// Execution reports (after profiles so a profile's --outdir is used)
// ============================================================

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
