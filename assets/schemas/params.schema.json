{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nf-codonyat params",
  "type": "object",
  "required": [
    "samplesheet",
    "reference",
    "amplicons"
  ],
  "properties": {
    "samplesheet": {
      "type": "string",
      "description": "CSV with columns sample,fastq_1,fastq_2,sam (FASTQ or SAM per row; sample,sam also accepted)"
    },
    "reference": {
      "type": "string",
      "description": "Annotated reference FASTA (header must contain protein annotations)"
    },
    "amplicons": {
      "type": "string",
      "description": "Amplicon definitions TSV (7 columns: label,protein,reference,5p_seq,3p_seq,start,end)"
    },
    "protein": {
      "type": "string",
      "default": "RT",
      "description": "Protein name to analyse"
    },
    "ratio_upper": {
      "type": "number",
      "default": 3.16227766,
      "description": "Strand ratio upper threshold"
    },
    "ratio_lower": {
      "type": "number",
      "default": 0.316227766,
      "description": "Strand ratio lower threshold"
    },
    "entropy_threshold": {
      "type": "number",
      "default": 0.0,
      "description": "Minimum Shannon entropy per position"
    },
    "fastp_args": {
      "type": "string",
      "default": "--qualified_quality_phred 20 --unqualified_percent_limit 40 --length_required 50 --cut_tail --cut_tail_mean_quality 20",
      "description": "fastp arguments for FASTQ samples (--detect_adapter_for_pe is added for paired-end reads; pairs are never merged)"
    },
    "bowtie2_args": {
      "type": "string",
      "default": "--very-sensitive-local",
      "description": "bowtie2 arguments for FASTQ samples"
    },
    "min_mapq": {
      "type": "integer",
      "default": 20,
      "minimum": 0,
      "description": "Minimum mapping quality (samtools view -q), FASTQ and SAM samples"
    },
    "exclude_flags": {
      "type": "string",
      "default": "0x904",
      "description": "SAM flags to drop (samtools view -F); 0x904 = unmapped, secondary, supplementary"
    },
    "outdir": {
      "type": "string",
      "default": "results"
    },
    "publish_dir_mode": {
      "type": "string",
      "default": "copy"
    }
  }
}
