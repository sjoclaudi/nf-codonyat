/*
 * =========================================================
 *  modules.config
 *  Process resources and publishing rules
 * =========================================================
 */

process {
    withLabel: 'process_low' {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }

    withLabel: 'process_medium' {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }

    withLabel: 'process_high' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }

    // Per-sample TSV + XML → <outdir>/samples/<sample_id>/
    withName: 'CODONYAT_RUN' {
        publishDir = [
            path: { "${params.outdir}/samples/${sample_id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,xml}'
        ]
    }

    // Combined table → <outdir>/codonyat_summary.tsv
    withName: 'CODONYAT_SUMMARY' {
        publishDir = [
            path: { params.outdir },
            mode: params.publish_dir_mode,
            pattern: 'codonyat_summary.tsv'
        ]
    }
}
