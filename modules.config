/*
 * =========================================================
 *  modules.config
 *  Process-level resource labels and execution hints
 * =========================================================
 */

process {
    // Default labels applied to all processes
    withLabel: 'process_low' {
        cpus   = 1
        memory = '2 GB'
        time   = '1h'
    }

    withLabel: 'process_medium' {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }

    withLabel: 'process_high' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    // ─── CODONYAT_RUN ────────────────────────────────────
    withName: 'CODONYAT_RUN' {
        label  = 'process_medium'
        // Install the codonyat Python package from PyPI (or GitHub once published)
        conda  = 'bioconda::biopython>=1.79'
        // Alternative: pip install from source
        // beforeScript = 'pip install codonyat'
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*'
        ]
    }

    // ─── CODONYAT_SUMMARY ─────────────────────────────────
    withName: 'CODONYAT_SUMMARY' {
        label  = 'process_low'
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: 'codonyat_summary.tsv'
        ]
    }
}

// ============================================================
// Debug
// ============================================================

timeline {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
