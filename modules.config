/*
 * =========================================================
 *  modules.config
 *  Process resources, tool arguments and publishing rules
 * =========================================================
 */

process {
    withLabel: 'process_single' {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }

    withLabel: 'process_low' {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }

    withLabel: 'process_medium' {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }

    withLabel: 'process_high' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }

    // ── FASTQ path ───────────────────────────────────────
    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }

    withName: 'FASTP' {
        // Paired-end runs also auto-detect adapters from read overlap
        ext.args   = { meta.single_end ? params.fastp_args : "${params.fastp_args} --detect_adapter_for_pe" }
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,html,log,fastq.gz}',
            saveAs: { fn -> (fn.endsWith('.fastq.gz') && !params.save_intermediates) ? null : fn }
        ]
    }

    // Viral references are small: the nf-core default (process_high) is far more than needed
    withName: 'BOWTIE2_BUILD' {
        cpus       = 2
        memory     = 4.GB
        publishDir = [ enabled: false ]
    }

    // Step 2: Kraken2 report (no reads removed; per-read output only with --save_intermediates)
    withName: 'KRAKEN2_KRAKEN2' {
        memory     = 10.GB
        ext.args   = { [
            "--confidence ${params.kraken2_confidence}",
            params.kraken2_memory_mapping ? '--memory-mapping' : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/contamination" },
            mode: params.publish_dir_mode,
            pattern: '*.{report.txt,classifiedreads.txt}'
        ]
    }

    withName: 'CONTAMINATION_SUMMARY|CONTAMINATION_COMBINE' {
        publishDir = [
            path: { "${params.outdir}/contamination" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv',
            saveAs: { fn -> fn.endsWith('_mqc.tsv') ? null : fn }
        ]
    }

    // Step 3: competitive mapping against the subtype panel; reads that tie
    // between references of different bins are tossed (reported as ambiguous)
    withName: 'BBMAP_BBSPLIT' {
        cpus       = 2
        memory     = 4.GB
        ext.args   = 'ambiguous=best ambiguous2=toss'
        publishDir = [
            path: { "${params.outdir}/subtype/bbsplit" },
            mode: params.publish_dir_mode,
            pattern: '*.stats.txt'
        ]
    }

    withName: 'SUBTYPE_ESTIMATE|SUBTYPE_COMBINE' {
        publishDir = [
            path: { "${params.outdir}/subtype" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv',
            saveAs: { fn -> fn.endsWith('_mqc.tsv') ? null : fn }
        ]
    }

    // Step 5: merge overlapping pairs (PE only)
    withName: 'BBMAP_BBMERGE' {
        memory     = 4.GB
        // ordered=t keeps the input read order (reproducible downstream tables)
        ext.args   = { "ordered=t ${params.bbmerge_args ?: ''}".trim() }
        publishDir = [
            path: { "${params.outdir}/merge" },
            mode: params.publish_dir_mode,
            pattern: '*.{log,txt}'
        ]
    }

    // Step 4: one Bowtie2 pass; PE samples are aligned in two parts
    // (merged reads as SE, not-merged pairs as PE) and merged below
    withName: 'BOWTIE2_ALIGN' {
        // --reorder: SAM records in input order, so ties in the sorted BAM (and the
        // row order of codonyat's tables) do not depend on thread scheduling
        ext.args   = { "${params.bowtie2_args} --reorder" }
        ext.prefix = { meta.part ? "${meta.id}.${meta.part}" : "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,log}',
            saveAs: { fn -> (fn.endsWith('.bam') && meta.part && !params.save_intermediates) ? null : fn }
        ]
    }

    withName: 'MERGE_ALIGNMENTS' {
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    // D9 strand branch: all trimmed pairs (before merging) aligned as pairs
    withName: 'BOWTIE2_ALIGN_STRAND' {
        ext.args   = { "${params.bowtie2_args} --reorder" }
        ext.prefix = { "${meta.id}.pairs" }
        publishDir = [
            path: { "${params.outdir}/strand" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,log}',
            saveAs: { fn -> (fn.endsWith('.bam') && !params.save_intermediates) ? null : fn }
        ]
    }

    withName: 'FILTER_STRAND' {
        ext.args   = { "-h -q ${params.min_mapq} -F ${params.exclude_flags} --output-fmt sam" }
        ext.prefix = { "${meta.id}.pairs.filtered" }
        publishDir = [ enabled: false ]
    }

    withName: 'CODONYAT_STRAND' {
        ext.prefix = { "${meta.id}.unmerged" }
        publishDir = [
            path: { "${params.outdir}/strand" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv',
            enabled: params.save_intermediates
        ]
    }

    withName: 'STRAND_METRICS' {
        publishDir = [
            path: { "${params.outdir}/strand" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    // ── Both paths ───────────────────────────────────────
    withName: 'FLAGSTAT_ALIGNED' {
        ext.prefix = { "${meta.id}.aligned" }
        publishDir = [
            path: { "${params.outdir}/alignment/flagstat" },
            mode: params.publish_dir_mode,
            pattern: '*.flagstat'
        ]
    }

    // Drops reads below --min_mapq and unmapped/secondary/supplementary
    // alignments (codonyat itself only skips unmapped reads)
    withName: 'FILTER_ALIGNMENTS' {
        ext.args   = { "-h -q ${params.min_mapq} -F ${params.exclude_flags} --output-fmt sam" }
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [ enabled: false ]
    }

    withName: 'FLAGSTAT_FILTERED' {
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${params.outdir}/alignment/flagstat" },
            mode: params.publish_dir_mode,
            pattern: '*.flagstat'
        ]
    }

    // Per-sample TSV + XML → <outdir>/samples/<sample>/
    withName: 'CODONYAT_RUN' {
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,xml}'
        ]
    }

    // Combined table → <outdir>/codonyat_summary.tsv
    withName: 'CODONYAT_SUMMARY' {
        publishDir = [
            path: { params.outdir },
            mode: params.publish_dir_mode,
            pattern: 'codonyat_summary.tsv'
        ]
    }

    // Step 6: consensus. Coordinate-sort the filtered alignments, then
    // samtools mpileup (all positions, no BAQ, no depth cap) | ivar consensus
    withName: 'SORT_FILTERED' {
        ext.prefix = { "${meta.id}.filtered.sorted" }
        publishDir = [ enabled: false ]
    }

    withName: 'IVAR_CONSENSUS' {
        ext.args   = { "-t ${params.consensus_threshold} -c ${params.consensus_insertion_threshold} -m ${params.consensus_min_depth} -n N -q ${params.consensus_min_bq}" }
        ext.args2  = '-aa -A -B -d 0 -Q 0'
        ext.prefix = { "${meta.id}.ivar" }
        publishDir = [
            path: { "${params.outdir}/consensus/ivar" },
            mode: params.publish_dir_mode,
            pattern: '*.{fa,qual.txt}',
            enabled: params.save_intermediates
        ]
    }

    withName: 'CONSENSUS_REPORT' {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            pattern: '*.{fa,tsv}'
        ]
    }

    // Amino-acid frequency tables (no drug, resistance or clinical annotation)
    withName: 'CODON_TO_AA' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'PROVENANCE' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*.{yml,json,md}'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = '--title "nf-codonyat" --comment "Research use only. Descriptive QC, contamination, subtype-estimate, consensus and frequency outputs; no drug-resistance or clinical interpretation."'
        ext.prefix = 'multiqc_report'
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            pattern: 'multiqc_report*'
        ]
    }
}
